{
  "name": "capacitor-zip4j",
  "version": "0.0.6",
  "description": "capacitor plugin for zip4j (android only)",
  "main": "dist/plugin.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Plugin/",
    "CapacitorZip4j.podspec"
  ],
  "author": "xeyqe",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xeyqe/capacitor-zip4j.git"
  },
  "bugs": {
    "url": "https://github.com/xeyqe/capacitor-zip4j/issues"
  },
  "keywords": [
    "capacitor",
    "plugin",
    "native"
  ],
  "type": "module",
  "scripts": {
    "verify": "npm run verify:web && npm run verify:android",
    "verify:ios": "cd ios && pod install && xcodebuild -workspace Plugin.xcworkspace -scheme Plugin -destination generic/platform=iOS && cd ..",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "verify:web": "npm run build",
    "lint": "npm run eslint && npm run prettier -- --check",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "eslint src example/vite.config.ts",
    "prettier": "prettier \"src/**/*.ts\" \"android/src/**/*.java\" \"example/src/**/*.{css,html,js}\" \"example/vite.config.ts\" \"*.mjs\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api Zip4JPlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "@capacitor/docgen": "0.3.1",
    "@capacitor/ios": "8.5.3",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-java": "^2.11.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.65.0",
    "swiftlint": "^2.0.0",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0 <9.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "homepage": "https://github.com/xeyqe/capacitor-zip4j#readme",
  "directories": {
    "example": "example"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
